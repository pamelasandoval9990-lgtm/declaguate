/***
 * valida que solo se ingresen numero con o sin decimales
 * este es la alternativa a la funcion noChars
 */

function decimalValidator(e)
{
    var keynum;
    var keychar;
    var numcheck;
    
     
    if(window.event) // IE
    {
        keynum = e.keyCode;
        
    }
    else if(e.which) // Netscape/Firefox/Opera
    {
        keynum = e.which;
       
    }
    
    keychar = String.fromCharCode(keynum);
    numcheck = /[\d]|\.|\n/;
      
    switch(e.keyCode)
    {
        case 8 :
            return true;
            break;
        case 9 :
            return true;
            break;
        case 13:
            return false;
            break;
        case 35: //end
            if(keychar=='#')
                return false;
            else
                return true;
            break;
        case 36://begin
            if(keychar=='$')
                return false;
            else
                return true;
            break;
        case 46:
            return true;
            break;
        default:
            return numcheck.test(keychar);
    }
}
          

/**
 * valida que se ingresen solo numero enteros (sin puntos decimales)
 */
function enteroValidator(e)
{
    var keynum;
    var keychar;
    var numcheck;
    if(window.event) // IE
    {
        keynum = e.keyCode;
        
    }
    else if(e.which) // Netscape/Firefox/Opera
    {
        keynum = e.which;
       
    }
    
    keychar = String.fromCharCode(keynum);
    numcheck = /\d/;
      
    switch(e.keyCode)
    {
        case 8 :
            return true;
            break;
        case 9 :
            return true;
            break;
        case 13:
            return false;
            break;
        case 35: //end
            if(keychar=='#')
                return false;
            else
                return true;
            break;
        case 36://begin
            if(keychar=='$')
                return false;
            else
                return true;
            break;
        case 46://sup
            if(keychar=='.')
                return false;
            else
                return true;
            break;
        default:
            return numcheck.test(keychar);
    }
}

